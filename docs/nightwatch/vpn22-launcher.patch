From b08c282656ae6fdb3867c6640edf3cbaf32cb5c1 Mon Sep 17 00:00:00 2001
From: visy (bbport) <noreply@bbport>
Date: Sat, 31 Oct 2026 18:25:30 +0200
Subject: [PATCH] Launcher: the Nightwatch VPN tunnel range is 10.8.0.0/22
 (10.8.0.2 - 10.8.3.254), as the game from visy 0.7.8

Room for 1021 players once the VPN server widens its pool from /24 (one planned restart). A /24 server only
hands out 10.8.0.x, which stays inside, so this build works before and after the server change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FiEKYuHpJgRRpmm2KX8smH
---
 launcher/windows/BloodborneLauncher/Core/VpnLobby.cs | 7 +++++--
 launcher/windows/SeamlessTests/VpnTests.cs           | 7 +++++--
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/launcher/windows/BloodborneLauncher/Core/VpnLobby.cs b/launcher/windows/BloodborneLauncher/Core/VpnLobby.cs
index ef5cdb1..6cb5742 100644
--- a/launcher/windows/BloodborneLauncher/Core/VpnLobby.cs
+++ b/launcher/windows/BloodborneLauncher/Core/VpnLobby.cs
@@ -32,8 +32,11 @@ public static class VpnLobby
     public const string Address = "10.8.0.1";
     private const int FlagPassword = 1, FlagOwn = 2;
 
-    /// <summary>A player address of the tunnel: 10.8.0.2 to 10.8.0.254.</summary>
-    public static bool IsTunnelAddress(uint ip) => (ip & 0xffffff00) == 0x0a080000 && (ip & 0xff) is >= 2 and <= 254;
+    /// <summary>A player address of the tunnel: 10.8.0.0/22 minus the network, the server (10.8.0.1) and the broadcast address,
+    /// i.e. 10.8.0.2 to 10.8.3.254 (visy 0.7.8: room for 1021 players once the server widens its pool from /24; a /24 server
+    /// only hands out 10.8.0.x, which is still inside). Same rule as the game (party_vpnlobby is_tunnel_player_address).</summary>
+    public static bool IsTunnelAddress(uint ip) =>
+        (ip & 0xfffffc00) == 0x0a080000 && ip != 0x0a080000 && ip != 0x0a080001 && ip != 0x0a0803ff;
 
     /// <summary>This PC's tunnel address, or null while the VPN is off.</summary>
     public static string? TunnelIp(IEnumerable<NetAdapter> adapters) =>
diff --git a/launcher/windows/SeamlessTests/VpnTests.cs b/launcher/windows/SeamlessTests/VpnTests.cs
index a124f26..286517d 100644
--- a/launcher/windows/SeamlessTests/VpnTests.cs
+++ b/launcher/windows/SeamlessTests/VpnTests.cs
@@ -136,8 +136,11 @@ static class VpnTests
         Check(VpnLobby.ParseReply(Reply(1, 0, Entry(TunnelHost, 9307, 1, 1, 4, name, Build)).Append((byte)0).ToArray()) == null, "trailing byte");
 
         Check(!VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.1")) && VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.2")) &&
-              VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.254")) && !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.255")) &&
-              !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.1.2")), "tunnel range");
+              VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.254")) && VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.255")) &&
+              VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.1.2")) && VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.3.254")) &&
+              !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.0.0")) && !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.3.255")) &&
+              !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.8.4.2")) && !VpnLobby.IsTunnelAddress(NetworkRoute.Parse("10.9.0.2")),
+              "tunnel range (10.8.0.0/22)");
         Check(VpnLobby.TunnelIp(new[] { new NetAdapter("lan", NetworkRoute.Parse("192.168.1.2")) }) == null, "no tunnel, nothing to bind");
 
         // Your own game, a game without a password and an address outside the tunnel are not rows.
-- 
