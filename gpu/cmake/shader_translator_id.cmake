# Writes OUT (a C file defining bbport_shader_translator_id()) from a hash of the shader
# translator's sources (SRC = gpu/shadps4/shader_recompiler, every .cpp / .h / .inc, by path and
# content, line endings normalised so a Windows and a Linux checkout agree), only when it changes.
# The shader cache's profile.bin carries it: SPIR-V and meta written by a build with another
# translator are translated again from their sources instead of being loaded (the hand-bumped
# ShaderBinaryVersion alone missed translator changes; upstream 80b631ef had two builds sharing
# one cache folder crash on each other's shaders).
#   cmake -DSRC=<dir> -DOUT=<file.c> -P shader_translator_id.cmake
file(GLOB_RECURSE files RELATIVE "${SRC}" "${SRC}/*.cpp" "${SRC}/*.h" "${SRC}/*.inc")
list(SORT files)
set(all "")
foreach(f IN LISTS files)
    file(READ "${SRC}/${f}" content)
    string(REPLACE "\r" "" content "${content}")
    string(SHA256 h "${content}")
    string(APPEND all "${f} ${h}\n")
endforeach()
string(SHA256 sum "${all}")
string(SUBSTRING "${sum}" 0 16 id)
list(LENGTH files n)
set(text "/* generated by gpu/cmake/shader_translator_id.cmake from ${n} files */\nunsigned long long bbport_shader_translator_id(void) { return 0x${id}ULL; }\n")
set(old "")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
