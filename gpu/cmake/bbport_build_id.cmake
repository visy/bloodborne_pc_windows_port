# Writes OUT (a C file defining bbport_build_id()) from `git describe` of SRC, only when the text
# changes, so a commit recompiles that one file. The party version check compares it (A9,
# docs/party/version_check.md).
#   cmake -DSRC=<repo> -DOUT=<file.c> -DVERSION=<x.y> -P bbport_build_id.cmake
set(id "")
find_program(GIT git)
if (GIT)
    execute_process(COMMAND "${GIT}" -C "${SRC}" describe --always --dirty --abbrev=10
                    OUTPUT_VARIABLE id ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
    if (NOT rc EQUAL 0)
        set(id "")
    endif()
endif()
if (id STREQUAL "")
    set(id "nogit")
endif()
set(text "/* generated by gpu/cmake/bbport_build_id.cmake */\nconst char* bbport_build_id(void) { return \"${VERSION} (${id})\"; }\n")
set(old "")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
